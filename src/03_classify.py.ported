#!/usr/bin/env python
"""classify.py - score each model's bacpipe embeddings at individual ID.

    python classify.py <embeddings_root> [species]

Session/identity now come from the MASTER METADATA (data/<sp>/metadata/<sp>_master.csv),
not from parsing the filename. The grouping unit is the TRUE recording_id (aa = tascam
recording; ag = recording_date+time), which fixes the date-leakage flagged in
text/eval_protocol.md sec 2 & 7. Clips with no resolved recording (session_known==0)
are dropped from the session-aware analysis and reported as such.

For each (subset, call set, model) one row carries BOTH splits:
  * by-recording (GroupKFold on recording_id)  -> PRIMARY, leak-free
  * random (StratifiedKFold)                   -> leaky upper bound; gap = leakage delta
and four lenses: linear probe, cosine nearest-centroid, verification (EER/AUROC),
clustering (purity/ARI).

Subsets:
  * aa  -> {all}                       (8 birds, one shared facility)
  * ag  -> {all, lab}                  all = 16 birds; lab = 11 maxplanck_lab birds
           (one shared room, so room cannot proxy identity - the confound-free number)

Outputs (tidy, for R; NO figures):
    results/<species>/<subset>/<set>/summary.csv      one row per model (both splits)
    results/<species>/<subset>/<set>/predictions.csv  per window, by-recording fold
"""
import os, sys, warnings, collections
from pathlib import Path
import numpy as np, pandas as pd
warnings.filterwarnings("ignore")
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler, LabelEncoder, normalize
from sklearn.model_selection import GroupKFold, StratifiedKFold
from sklearn.metrics import accuracy_score, f1_score, roc_auc_score, roc_curve, adjusted_rand_score
from sklearn.cluster import KMeans

N_FOLDS = 5
SEED = 42

# acorn_upstaris_240517_0777 = one ~111 s continuous recording (109 windows for ~1 s
# models); not a normal call bout, would dominate the short-window "all" set. Dropped.
DROP_CLIPS = {"acorn_upstaris_240517_0777"}

# subset -> predicate on a master row (bird-level filters)
SUBSETS = {
    "aa": {"all": lambda r: True},
    "ag": {"all": lambda r: True,
           "lab": lambda r: r["environment_class"] == "lab"},
}


def find_master(species):
    if os.environ.get("MASTER_DIR"):
        p = Path(os.environ["MASTER_DIR"]) / f"{species}_master.csv"
        if p.exists():
            return p
    for base in [Path.cwd(), *Path.cwd().parents]:
        p = base / f"data/{species}/metadata/{species}_master.csv"
        if p.exists():
            return p
    raise FileNotFoundError(f"{species}_master.csv not found (set MASTER_DIR)")


def load_master(species):
    df = pd.read_csv(find_master(species), dtype=str)
    return {r["original_stem"]: r for _, r in df.iterrows()}


def model_dirs(root):
    out = {}
    for d in sorted(Path(root).iterdir()):
        if d.is_dir() and "___" in d.name and list(d.rglob("*.npy")):
            out[d.name.split("___")[1].rsplit("-", 1)[0]] = d
    return out


def infer_species(root):
    parts = [x.lower() for x in Path(root).resolve().parts]
    for tok in ("aa", "ag"):
        if tok in parts:
            return tok
    r = Path(root).resolve()
    return (r.parent.name if r.name == "embeddings" else r.name).lower()


def collect_single_stems(mdirs):
    return {f.name[: -len(f'_{m}.npy')] for m, d in mdirs.items()
            for f in d.rglob(f'*_{m}.npy') if '/single/' in f.as_posix()}


def load(model_dir, model, master, single_stems):
    """One row per model-native window; bird+session+kind come from master."""
    rows = []
    for f in sorted(model_dir.rglob(f"*_{model}.npy")):
        stem = f.name[: -len(f"_{model}.npy")]
        if stem in DROP_CLIPS or stem not in master:
            continue
        m = master[stem]
        if str(m.get("session_known")) != "1" or m.get("recording_id") in (None, "NA"):
            continue
        bird, sess = m["bird"].lower(), m["recording_id"]
        kind = m.get("kind", "single") if stem not in single_stems else "single"
        # trust master 'kind' but keep single_stems as the cross-model singles anchor
        kind = "single" if stem in single_stems else m.get("kind", "repeated")
        try:
            v = np.atleast_2d(np.load(f))
        except Exception:
            continue
        if v.ndim != 2:
            continue
        for w in v:
            if np.isfinite(w).all():
                rows.append((stem, bird, sess, kind, m["environment_class"], w.astype(np.float32)))
    return pd.DataFrame(rows, columns=["clip_id", "bird", "session", "kind", "env", "emb"])


def probe(X, y, groups, mode, clips=None):
    le = LabelEncoder(); yy = le.fit_transform(y)
    if mode == "session_aware":
        splits = GroupKFold(n_splits=N_FOLDS).split(X, yy, groups)
    else:
        splits = StratifiedKFold(N_FOLDS, shuffle=True, random_state=SEED).split(X, yy)
    accs, f1s, yt, yp, cl = [], [], [], [], []
    for tr, te in splits:
        if len(np.unique(yy[tr])) < len(le.classes_):
            continue
        sc = StandardScaler().fit(X[tr])
        clf = LogisticRegression(max_iter=1500, random_state=SEED, n_jobs=1)
        clf.fit(sc.transform(X[tr]), yy[tr])
        pr = clf.predict(sc.transform(X[te]))
        accs.append(accuracy_score(yy[te], pr)); f1s.append(f1_score(yy[te], pr, average="macro"))
        yt += list(le.classes_[yy[te]]); yp += list(le.classes_[pr])
        if clips is not None:
            cl += list(clips[te])
    m = lambda a: float(np.mean(a)) if a else float("nan")
    return dict(acc=m(accs), sd=(float(np.std(accs)) if accs else float("nan")), f1=m(f1s),
                y_true=yt, y_pred=yp, clip=cl)


def centroid(X, y, groups, mode, clips=None):
    le = LabelEncoder(); yy = le.fit_transform(y)
    if mode == "session_aware":
        splits = GroupKFold(n_splits=N_FOLDS).split(X, yy, groups)
    else:
        splits = StratifiedKFold(N_FOLDS, shuffle=True, random_state=SEED).split(X, yy)
    accs, f1s, yt, yp, cl = [], [], [], [], []
    for tr, te in splits:
        if len(np.unique(yy[tr])) < len(le.classes_):
            continue
        Xtr, Xte = normalize(X[tr]), normalize(X[te])
        cents = normalize(np.stack([Xtr[yy[tr] == c].mean(0) for c in range(len(le.classes_))]))
        pr = (Xte @ cents.T).argmax(1)
        accs.append(accuracy_score(yy[te], pr)); f1s.append(f1_score(yy[te], pr, average="macro"))
        yt += list(le.classes_[yy[te]]); yp += list(le.classes_[pr])
        if clips is not None:
            cl += list(clips[te])
    m = lambda a: float(np.mean(a)) if a else float("nan")
    return dict(acc=m(accs), sd=(float(np.std(accs)) if accs else float("nan")), f1=m(f1s),
                y_true=yt, y_pred=yp, clip=cl)


def fuse_clips(y_true, y_pred, clip):
    votes, truth = collections.defaultdict(list), {}
    for c, t, p in zip(clip, y_true, y_pred):
        votes[c].append(p); truth[c] = t
    clips = list(votes)
    yt = [truth[c] for c in clips]
    yp = [collections.Counter(votes[c]).most_common(1)[0][0] for c in clips]
    return float(accuracy_score(yt, yp)), float(f1_score(yt, yp, average="macro"))


def encounter_fusion(X, y, groups, clips):
    """Pool a bird's calls within a held-out RECORDING into one mean query -> nearest
    enrolled centroid (session-aware). The deployment unit; the main honest AG lever."""
    le = LabelEncoder(); yy = le.fit_transform(y)
    accs = []
    for tr, te in GroupKFold(n_splits=N_FOLDS).split(X, yy, groups):
        if len(np.unique(yy[tr])) < len(le.classes_):
            continue
        Xtr = normalize(X[tr])
        cents = normalize(np.stack([Xtr[yy[tr] == c].mean(0) for c in range(len(le.classes_))]))
        # group test windows by (bird, recording)
        g = groups[te]; yt = yy[te]; Xte = normalize(X[te])
        bucket = collections.defaultdict(list)
        for i in range(len(te)):
            bucket[(yt[i], g[i])].append(Xte[i])
        if not bucket:
            continue
        qy = np.array([k[0] for k in bucket])
        Q = normalize(np.stack([np.mean(v, 0) for v in bucket.values()]))
        pr = (Q @ cents.T).argmax(1)
        accs.append(accuracy_score(qy, pr))
    return float(np.mean(accs)) if accs else float("nan")


def verification(X, y, groups):
    Xn = normalize(X); sims = Xn @ Xn.T
    iu = np.triu_indices(len(y), k=1); s = sims[iu]
    same_bird = (y[:, None] == y[None, :])[iu]
    same_sess = (groups[:, None] == groups[None, :])[iu]
    pos = same_bird & ~same_sess; neg = ~same_bird; keep = pos | neg
    lab = pos[keep].astype(int); sc = s[keep]
    if lab.sum() == 0 or lab.sum() == len(lab):
        return float("nan"), float("nan")
    auc = float(roc_auc_score(lab, sc))
    fpr, tpr, _ = roc_curve(lab, sc); fnr = 1 - tpr
    return auc, float(fpr[np.nanargmin(np.abs(fnr - fpr))])


def clustering(X, y):
    k = len(np.unique(y))
    lab = KMeans(n_clusters=k, random_state=SEED, n_init=10).fit_predict(StandardScaler().fit_transform(X))
    return float(pd.crosstab(lab, y).max(axis=1).sum() / len(y)), float(adjusted_rand_score(y, lab))


def run_model(df, species, subset, setname, model):
    if len(df) < 20 or df["bird"].nunique() < 2:
        return None, None
    X = np.stack(df["emb"].to_list()); y = df["bird"].to_numpy()
    g = df["session"].to_numpy(); cl = df["clip_id"].to_numpy()
    sa = probe(X, y, g, "session_aware", clips=cl); rd = probe(X, y, g, "random")
    ce = centroid(X, y, g, "session_aware", clips=cl); ce_rd = centroid(X, y, g, "random")
    sa_acc_clip, sa_f1_clip = fuse_clips(sa["y_true"], sa["y_pred"], sa["clip"])
    ce_acc_clip, ce_f1_clip = fuse_clips(ce["y_true"], ce["y_pred"], ce["clip"])
    enc = encounter_fusion(X, y, g, cl)
    auc, eer = verification(X, y, g); pur, ari = clustering(X, y)
    nb = int(df["bird"].nunique())
    row = dict(species=species, subset=subset, call_set=setname, model=model,
               n_windows=len(df), n_clips=int(df["clip_id"].nunique()), n_birds=nb,
               n_recordings=int(df["session"].nunique()), dim=int(X.shape[1]),
               chance=1.0 / nb,
               # linear probe
               probe_byrec_acc=sa["acc"], probe_byrec_sd=sa["sd"], probe_byrec_f1=sa["f1"],
               probe_byrec_acc_clip=sa_acc_clip,
               probe_random_acc=rd["acc"], probe_leakage_delta=rd["acc"] - sa["acc"],
               probe_lift_over_chance=(sa["acc"] * nb),
               # cosine nearest-centroid
               centroid_byrec_acc=ce["acc"], centroid_byrec_sd=ce["sd"], centroid_byrec_f1=ce["f1"],
               centroid_byrec_acc_clip=ce_acc_clip,
               centroid_random_acc=ce_rd["acc"], centroid_leakage_delta=ce_rd["acc"] - ce["acc"],
               # encounter (recording-level) fusion
               encounter_byrec_acc=enc,
               # unsupervised / open-set
               auc=auc, eer=eer, cluster_purity=pur, cluster_ari=ari)
    preds = [dict(species=species, subset=subset, call_set=setname, model=model,
                  clip_id=c, true=t, pred=p)
             for c, t, p in zip(sa["clip"], sa["y_true"], sa["y_pred"])]
    return row, preds


def _done_keys(path):
    if not Path(path).exists():
        return set()
    try:
        d = pd.read_csv(path)
        return set(zip(d["subset"], d["call_set"], d["model"]))
    except Exception:
        return set()


def _append(path, row):
    df = pd.DataFrame([row]) if isinstance(row, dict) else pd.DataFrame(row)
    hdr = not Path(path).exists()
    df.to_csv(path, mode="a", header=hdr, index=False)


def main():
    root = Path(sys.argv[1]).resolve()
    species = sys.argv[2] if len(sys.argv) > 2 else infer_species(root)
    master = load_master(species)
    mdirs = model_dirs(root)
    single_stems = collect_single_stems(mdirs)
    subsets = SUBSETS.get(species, {"all": lambda r: True})
    outroot = Path("results") / species; outroot.mkdir(parents=True, exist_ok=True)
    rows_csv = outroot / "rows.csv"; preds_csv = outroot / "preds.csv"
    done = _done_keys(rows_csv)
    print(f"species={species} | {len(mdirs)} models | subsets={list(subsets)} | already done={len(done)}", flush=True)
    for subset, pred_fn in subsets.items():
        keep_stems = {s for s, r in master.items() if pred_fn(r)}
        has_rep = any(str(master[st].get("kind"))=="repeated" for st in keep_stems if st in master)
        sets = [("single", True), ("all", False)] if has_rep else [("single", True)]
        for setname, single_only in sets:
            for model, d in sorted(mdirs.items()):
                if (subset, setname, model) in done:
                    continue
                df = load(d, model, master, single_stems)
                df = df[df["clip_id"].isin(keep_stems)]
                if single_only:
                    df = df[df["kind"] == "single"]
                row, pr = run_model(df, species, subset, setname, model)
                if row is None:
                    print(f"  [{subset}/{setname}] {model}: too few, skipped", flush=True); continue
                _append(rows_csv, row); _append(preds_csv, pr)
                done.add((subset, setname, model))
                print(f"  [{subset}/{setname}] {model}: probe by-rec {row['probe_byrec_acc']:.3f} "
                      f"(rand {row['probe_random_acc']:.3f}, chance {row['chance']:.3f}) "
                      f"centroid {row['centroid_byrec_acc']:.3f} enc {row['encounter_byrec_acc']:.3f} "
                      f"eer {row['eer']:.3f}", flush=True)
    print(f"species={species} COMPLETE: {len(done)} model-combos", flush=True)


if __name__ == "__main__":
    main()
